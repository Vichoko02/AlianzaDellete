# Contraseñas del directorio. instalar.sh copia este archivo a /etc/alianza/ldap.env (solo lo lee root).
# Cambia TODAS las contraseñas (mínimo 12 caracteres). Nunca subas el archivo con valores al repositorio.

# Dominio → base DN (alianza.local → dc=alianza,dc=local)
LDAP_DOMINIO=alianza.local
LDAP_ORGANIZACION="La Alianza"

# Administrador raíz del directorio (cn=admin,dc=alianza,dc=local). Solo para emergencias.
LDAP_CONTRASENA_ADMIN=

# Cuenta de servicio del servidor de La Alianza (cn=alianza-backend,ou=services,...).
# Debe coincidir con Ldap__CuentaServicioContrasena en /etc/alianza/servidor.env.
LDAP_CONTRASENA_SERVIDOR=

# Contraseña de uid=yishadmin en el directorio (para otras apps que usen LDAP).
LDAP_CONTRASENA_YISHADMIN=
