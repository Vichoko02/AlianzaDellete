# Copia este archivo a .env y completa los valores. .env está en .gitignore: nunca lo subas.

# Contraseña de PostgreSQL
CONTRASENA_POSTGRES=

# Clave para firmar las sesiones del panel (mínimo 32 caracteres). Genera una con: openssl rand -hex 32
CLAVE_SESIONES=

# Superadministrador. La contraseña solo se usa al crear la cuenta la primera vez
# (mínimo 10 caracteres, con letras y números). Después puedes borrarla de aquí y cambiarla desde "Mi cuenta".
SUPERADMIN_USUARIO=YishAdmin
SUPERADMIN_CONTRASENA=

# Dirección pública de este servidor (para las URL de las imágenes). Ej: https://api.alianza.cl
URL_SERVIDOR=
# Dirección del sitio público (React), autorizada a llamar a la API. Ej: https://alianza.cl
URL_SITIO=http://localhost:5173

# Importación inicial de las wikis y socios que tenía el sitio (solo si la base de datos no tiene series).
# CARPETA_IMAGENES_SITIO debe apuntar a la carpeta src/assets del sitio.
IMPORTAR_CONTENIDO=false
CARPETA_IMAGENES_SITIO=

# Solo con docker-compose.ldap.yml (debe coincidir con LDAP_CONTRASENA_SERVIDOR del LDAP)
LDAP_BASE_DN=dc=alianza,dc=local
LDAP_CONTRASENA_SERVIDOR=

PUERTO=8080
