# Copia este archivo a .env y cambia TODAS las contraseñas (mínimo 12 caracteres).
# .env está en .gitignore: nunca lo subas al repositorio.

# Dominio → base DN (alianza.local → dc=alianza,dc=local)
LDAP_DOMINIO=alianza.local
LDAP_ORGANIZACION=La Alianza

# Administrador raíz del directorio (cn=admin,dc=alianza,dc=local). Solo para emergencias.
LDAP_CONTRASENA_ADMIN=

# Cuenta de servicio del servidor (cn=alianza-backend,ou=services,...).
# Debe coincidir con Ldap__CuentaServicioContrasena en el .env del servidor.
LDAP_CONTRASENA_SERVIDOR=

# Contraseña de uid=yishadmin en el directorio (para otras apps que usen LDAP).
LDAP_CONTRASENA_YISHADMIN=

# Puertos publicados solo en 127.0.0.1
LDAP_PUERTO_LOCAL=389
PHPLDAPADMIN_PUERTO=8090
