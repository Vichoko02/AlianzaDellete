# Copia este archivo a .env y completa los valores. .env está en .gitignore: nunca lo subas.

# Contraseña de PostgreSQL
POSTGRES_PASSWORD=

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con: openssl rand -hex 32
JWT_CLAVE=

# Superadministrador. ADMIN_PASSWORD solo se usa al crear la cuenta la primera vez
# (mínimo 10 caracteres, con letras y números). Después puedes borrarla de aquí y cambiarla desde "Mi cuenta".
ADMIN_USERNAME=YishAdmin
ADMIN_PASSWORD=

# URL pública de la API (para construir URLs absolutas de imágenes). Ej: https://api.alianza.cl
URL_PUBLICA_API=
# Origen del sitio público (React) autorizado por CORS. Ej: https://alianza.cl
CORS_ORIGEN_SITIO=http://localhost:5173

# Importación inicial de las wikis y socios que hoy están en el frontend (solo si la BD no tiene series).
# RUTA_ASSETS_FRONTEND debe apuntar a proyecto-alianza/VistaUsuario/src/assets del repositorio del sitio.
IMPORTAR_CONTENIDO=false
RUTA_ASSETS_FRONTEND=

# Solo con docker-compose.ldap.yml (debe coincidir con LDAP_BACKEND_PASSWORD de alianza-ldap)
LDAP_BASE_DN=dc=alianza,dc=local
LDAP_BACKEND_PASSWORD=

API_PUERTO=8080
SWAGGER=false
