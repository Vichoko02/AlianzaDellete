# Configuración inicial de OpenLDAP (cn=config) para La Alianza.
# Plantilla: las variables ${...} las rellena comandos/inicio.sh con envsubst.

dn: cn=config
objectClass: olcGlobal
cn: config
olcPidFile: ${LDAP_RUN_DIR}/slapd.pid
olcArgsFile: ${LDAP_RUN_DIR}/slapd.args
olcLogLevel: stats
# Rechaza binds anónimos con contraseña vacía y exige autenticación para leer.
olcDisallows: bind_anon
olcRequires: authc
olcIdleTimeout: 600
olcSizeLimit: 500

dn: cn=module{0},cn=config
objectClass: olcModuleList
cn: module{0}
olcModulePath: ${LDAP_MODULE_DIR}
olcModuleLoad: back_mdb
olcModuleLoad: memberof
olcModuleLoad: refint
olcModuleLoad: ppolicy

dn: cn=schema,cn=config
objectClass: olcSchemaConfig
cn: schema

include: file://${LDAP_SCHEMA_DIR}/core.ldif
include: file://${LDAP_SCHEMA_DIR}/cosine.ldif
include: file://${LDAP_SCHEMA_DIR}/nis.ldif
include: file://${LDAP_SCHEMA_DIR}/inetorgperson.ldif

# El acceso a la configuración solo es posible como root local por el socket ldapi.
dn: olcDatabase={-1}frontend,cn=config
objectClass: olcDatabaseConfig
objectClass: olcFrontendConfig
olcDatabase: {-1}frontend
olcPasswordHash: {SSHA}
olcAccess: {0}to * by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage by * break
olcAccess: {1}to dn.base="" by * read
olcAccess: {2}to dn.base="cn=Subschema" by * read

dn: olcDatabase={0}config,cn=config
objectClass: olcDatabaseConfig
olcDatabase: {0}config
olcAccess: {0}to * by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage by * none

dn: olcDatabase={1}mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: {1}mdb
olcDbDirectory: ${LDAP_DATA_DIR}
olcSuffix: ${LDAP_BASE_DN}
olcRootDN: cn=admin,${LDAP_BASE_DN}
olcRootPW: ${LDAP_CONTRASENA_ADMIN_HASH}
olcDbMaxSize: 1073741824
olcDbIndex: objectClass eq
olcDbIndex: uid,cn,mail eq,sub
olcDbIndex: member,memberOf eq
olcLastMod: TRUE
# 0: root local (por el socket ldapi dentro del contenedor) administra todo; lo usan los comandos.
olcAccess: {0}to * by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage by * break
# 1: las contraseñas solo se usan para autenticar; el servidor puede cambiarlas, cada usuario la suya.
olcAccess: {1}to attrs=userPassword,shadowLastChange
  by dn.exact="cn=alianza-backend,ou=services,${LDAP_BASE_DN}" write
  by self write
  by anonymous auth
  by * none
# 2: estado de bloqueo de ppolicy, solo visible para el servidor.
olcAccess: {2}to attrs=pwdAccountLockedTime,pwdFailureTime,pwdHistory,pwdChangedTime
  by dn.exact="cn=alianza-backend,ou=services,${LDAP_BASE_DN}" write
  by * none
# 3: usuarios y grupos los administra la cuenta de servicio del servidor.
olcAccess: {3}to dn.subtree="ou=people,${LDAP_BASE_DN}"
  by dn.exact="cn=alianza-backend,ou=services,${LDAP_BASE_DN}" write
  by group.exact="cn=alianza-lectores,ou=groups,${LDAP_BASE_DN}" read
  by self read
  by * none
olcAccess: {4}to dn.subtree="ou=groups,${LDAP_BASE_DN}"
  by dn.exact="cn=alianza-backend,ou=services,${LDAP_BASE_DN}" write
  by group.exact="cn=alianza-lectores,ou=groups,${LDAP_BASE_DN}" read
  by users read
  by * none
# 5: el resto (raíz, OUs, políticas) es de solo lectura para cuentas autenticadas.
olcAccess: {5}to *
  by dn.exact="cn=alianza-backend,ou=services,${LDAP_BASE_DN}" read
  by users read
  by * none

# memberOf: cada usuario muestra los grupos a los que pertenece (útil para otras apps).
dn: olcOverlay={0}memberof,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcMemberOf
olcOverlay: {0}memberof
olcMemberOfRefInt: TRUE
olcMemberOfGroupOC: groupOfNames
olcMemberOfMemberAD: member
olcMemberOfMemberOfAD: memberOf

# refint: al borrar o renombrar un usuario se actualizan los grupos que lo referencian.
dn: olcOverlay={1}refint,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcRefintConfig
olcOverlay: {1}refint
olcRefintAttribute: member
olcRefintNothing: cn=admin,${LDAP_BASE_DN}

# ppolicy: guarda las contraseñas siempre como hash y bloquea tras intentos fallidos.
dn: olcOverlay={2}ppolicy,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: {2}ppolicy
olcPPolicyDefault: cn=default,ou=policies,${LDAP_BASE_DN}
olcPPolicyHashCleartext: TRUE
olcPPolicyUseLockout: FALSE
