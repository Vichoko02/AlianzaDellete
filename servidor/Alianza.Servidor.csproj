<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Alianza.Servidor</RootNamespace>
    <!-- Pensado para un servidor con poca memoria: recolector de basura de estación de trabajo (un solo montón, sin hilo
         concurrente), que devuelve memoria al sistema; y sin datos de culturas (ICU), que ahorra ~30 MB. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- Versiones exactas de cada paquete en packages.lock.json: la misma compilación hoy y en un año. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <!-- El contenido inicial viaja junto al servidor. -->
  <ItemGroup>
    <None Include="../carga-inicial/**" LinkBase="carga-inicial" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="publico/**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Compila el panel (panel/*.ts → publico/panel/*.js). Se omite con -p:CompilarPanel=false (empaquetar.sh lo compila antes). -->
  <PropertyGroup>
    <CompilarPanel Condition="'$(CompilarPanel)' == ''">true</CompilarPanel>
    <RaizRepositorio>$(MSBuildProjectDirectory)/..</RaizRepositorio>
  </PropertyGroup>
  <Target Name="CompilarPanelTs" BeforeTargets="BeforeBuild" Condition="'$(CompilarPanel)' == 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(RaizRepositorio)" Condition="!Exists('$(RaizRepositorio)/node_modules')" />
    <Exec Command="npm run build --silent" WorkingDirectory="$(RaizRepositorio)" />
  </Target>
</Project>
