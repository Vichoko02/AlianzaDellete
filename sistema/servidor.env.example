# Configuración del servidor de La Alianza. instalar.sh la copia a /etc/alianza/servidor.env (solo la lee root y el servicio).
# Nunca subas este archivo con valores al repositorio.

# Base de datos local por socket Unix: el usuario del sistema "alianza" entra sin contraseña (autenticación peer).
BaseDeDatos=Host=/var/run/postgresql;Database=alianza;Username=alianza;Maximum Pool Size=10

# Clave para firmar las sesiones del panel (instalar.sh genera una al azar).
Sesiones__Clave=

# Superadministrador. La contraseña solo se usa la primera vez, para crear la cuenta;
# después bórrala de aquí y cámbiala desde «Mi cuenta» en el panel.
Superadmin__NombreUsuario=YishAdmin
Superadmin__Contrasena=

# Dirección pública del sitio (para el enlace «Ver en el sitio» del panel). Ej: https://alianza.cl
Publico__UrlSitio=

# Importación inicial del contenido que tenía el sitio (solo si la base de datos no tiene series).
# CarpetaImagenes debe apuntar a la carpeta src/assets del sitio, copiada al servidor.
CargaInicial__ImportarContenido=false
CargaInicial__CarpetaImagenes=

# LDAP (opcional, rama programa/ldap). Usa la misma contraseña que LDAP_CONTRASENA_SERVIDOR de /etc/alianza/ldap.env.
Ldap__Habilitado=false
Ldap__Servidor=127.0.0.1
Ldap__CuentaServicioContrasena=
